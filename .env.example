# Frontend environment variables (Next.js).
# All NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time —
# changing them in the hosting env (Netlify) requires a fresh deploy to take effect.
# Copy to .env for local dev. Real values live in the Netlify environment, not here.

# Backend API base URL (include the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Razorpay checkout public key id.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# PostHog product analytics. The instrumentation in src/utils/analytics.ts
# short-circuits (no events) unless NEXT_PUBLIC_POSTHOG_KEY is set.
# Key is the PostHog project API key (public, starts with phc_).
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Host must match your PostHog project region. Defaults to https://app.posthog.com
# if unset; set to https://us.i.posthog.com or https://eu.i.posthog.com for those regions.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
